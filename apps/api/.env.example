APP_MODE=public

# Points at your existing local MySQL instance (already has the rentease
# schema loaded) — not a container spun up by docker-compose.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=rentease
DB_POOL_SIZE=20

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_DOMAIN=localhost
# false for local http:// dev; set true once behind real HTTPS in production
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
S3_ENDPOINT=http://minio:9000
# Browser-facing host used only to sign presigned upload URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=rentease
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
TAX_RATE=0.0

# Booking confirmation email (spec §4.2). Defaults target the local MailDev
# container from docker-compose.yml — view sent mail at http://localhost:1080.
# Point these at a real provider's SMTP relay (SES/SendGrid/etc.) in production.
SMTP_HOST=mailer
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=RentEase <bookings@rentease.local>
